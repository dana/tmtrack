[Unit]
Description=TMTrack Docker Container
After=network.target docker.service
Requires=docker.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f tmtrack
ExecStart=/usr/bin/docker run --name tmtrack -v /home/dana/user_authentication.json:/app/user_authentication.json --network=host dana/tmtrack:latest
ExecStop=/usr/bin/docker stop tmtrack
ExecStopPost=-/usr/bin/docker rm -f tmtrack
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
